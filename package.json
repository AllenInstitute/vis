{
    "name": "@alleninstitute/vis",
    "type": "module",
    "packageManager": "pnpm@11.21.0",
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "24.15.0",
            "onFail": "warn"
        }
    },
    "scripts": {
        "build": "pnpm -r run --no-bail build",
        "dev": "pnpm -r --parallel run dev",
        "test": "pnpm -r run --no-bail test:ci",
        "coverage": "pnpm -r run coverage",
        "typecheck": "pnpm -r --no-bail run typecheck",
        "fmt": "oxfmt && prettier --write 'site/**/*.astro'",
        "fmt:check": "oxfmt --check && prettier --check 'site/**/*.astro'",
        "lint": "oxlint --fix",
        "lint:check": "oxlint",
        "check": "oxfmt --check && prettier --check 'site/**/*.astro' && oxlint",
        "check:fix": "oxfmt && prettier --write 'site/**/*.astro' && oxlint --fix",
        "changelog": "pnpm -r run changelog"
    },
    "devDependencies": {
        "oxfmt": "0.61.0",
        "oxlint": "1.80.0",
        "prettier": "3.9.6",
        "prettier-plugin-astro": "0.14.1",
        "@parcel/packager-ts": "2.16.4",
        "@parcel/transformer-typescript-types": "2.16.4",
        "@vitest/coverage-istanbul": "4.1.1",
        "buffer": "6.0.3",
        "git-cliff": "2.13.1",
        "lefthook": "2.1.10",
        "parcel": "2.16.4",
        "process": "0.11.10",
        "typescript": "5.9.3",
        "vitest": "4.1.1"
    },
    "volta": {
        "node": "24.15.0",
        "pnpm": "11.21.0"
    }
}
