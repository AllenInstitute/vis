{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "printWidth": 120,
    "trailingComma": "es5",
    "tabWidth": 4,
    "singleQuote": true,
    "semi": true,
    "singleAttributePerLine": true,
    "sortPackageJson": false,
    "astro": true,
    "ignorePatterns": [
        "dist",
        "build",
        "pnpm-lock.yaml",
        "package-lock.json",
        "*.code-workspace",
        ".history/",
        ".idea",
        ".AppleDouble",
        ".LSOverride",
        "Icon",
        "._*",
        ".DocumentRevisions-V100",
        ".fseventsd",
        ".Spotlight-V100",
        ".TemporaryItems",
        ".Trashes",
        ".VolumeIcon.icns",
        ".com.apple.timemachine.donotpresent",
        ".AppleDB",
        ".AppleDesktop",
        "Network Trash Folder",
        "Temporary Items",
        ".apdisk",
        "logs",
        "*.log",
        "report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json",
        "pids",
        "*.pid",
        "*.seed",
        "*.pid.lock",
        "*.tsbuildinfo",
        "*.tgz",
        ".env.test"
    ]
}
